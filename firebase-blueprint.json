{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the Neural Syndicate OS",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique identifier"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address"
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name"
        },
        "photoURL": {
          "type": "string",
          "description": "The user's profile picture URL"
        },
        "balance": {
          "type": "number",
          "description": "The user's NRO balance"
        },
        "rank": {
          "type": "string",
          "description": "The user's rank in the syndicate"
        },
        "hackLevel": {
          "type": "number",
          "description": "The user's hacking skill level"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user account was created"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Bet": {
      "title": "Bet",
      "description": "A bet placed by a user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The bet's unique identifier"
        },
        "userId": {
          "type": "string",
          "description": "The user who placed the bet"
        },
        "matchId": {
          "type": "string",
          "description": "The ID of the match"
        },
        "type": {
          "type": "string",
          "enum": ["HOME", "DRAW", "AWAY"],
          "description": "The type of bet"
        },
        "amount": {
          "type": "number",
          "description": "The amount wagered"
        },
        "potentialPayout": {
          "type": "number",
          "description": "The potential payout if won"
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "WON", "LOST"],
          "description": "The status of the bet"
        },
        "timestamp": {
          "type": "number",
          "description": "When the bet was placed"
        }
      },
      "required": ["id", "userId", "matchId", "type", "amount", "status", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles"
    },
    "bets/{betId}": {
      "schema": {
        "$ref": "#/entities/Bet"
      },
      "description": "Stores all bets"
    }
  }
}
