# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# COLLECT_API_KEY: CollectAPI anahtarınız (Gol krallığı ve maç sonuçları için)
COLLECT_API_KEY=""

# SPORTMONKS_API_TOKEN: Sportmonks API anahtarınız (Canlı maç skorları için)
# Eğer boş bırakılırsa sistem otomatik olarak "Canlı Skor Simülasyon Modu"na geçer.
SPORTMONKS_API_TOKEN=""
